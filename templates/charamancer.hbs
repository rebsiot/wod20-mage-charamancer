                </div>

                {{#if baseEvaluation.valid}}
                <div class="mc-validation good"><strong>Basic character complete.</strong> Everything required for normal creation is allocated. You can now spend up to {{rules.freebies}} Freebie Points.</div>
                {{#if spherePlanNeedsArete}}
                <div class="mc-validation warning"><strong>{{requiredAreteFreebieCost}} FP will be spent automatically on Arete.</strong> Your planned Spheres reach {{requiredArete}}, so entering the Freebies phase will automatically raise Arete from {{rules.baseArete}} to {{requiredArete}}. You will then have {{baseFreebiesAfterRequiredArete}} FP left for optional purchases.</div>
                {{/if}}
                {{else}}
                    {{#if baseEvaluation.hasHardErrors}}
                    <div class="mc-validation bad"><strong>Base character is not ready yet.</strong> Red items are actual setup/rule problems. Yellow items mean required normal dots are still unspent.</div>
                    {{else}}
                    <div class="mc-validation warning"><strong>Base creation is still in progress.</strong> Finish the yellow allocation reminders below.</div>
                    {{/if}}
                {{/if}}

                {{#if baseEvaluation.errors.length}}
                <div class="mc-review-issues">
                    {{#each baseEvaluation.errors}}
                    <article class="mc-error-card {{#if advisory}}advisory{{/if}}">
                        <div class="mc-error-tab">{{#if advisory}}Allocation reminder · {{/if}}{{tab}} tab</div>
                        <div class="mc-error-message">{{message}}</div>
                        <div class="mc-error-fix"><strong>{{#if advisory}}What to do:{{else}}How to fix it:{{/if}}</strong> {{fix}}</div>
                        {{#if canJump}}<button type="button" data-error-step="{{stepIndex}}">Go to {{tab}}</button>{{/if}}
                    </article>
                    {{/each}}
                </div>
                {{/if}}

