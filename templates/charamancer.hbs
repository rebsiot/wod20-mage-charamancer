<div class="mage-charamancer-shell">
    <nav class="mc-steps" aria-label="Character creation steps">
        {{#each steps}}
        <button type="button"
                class="mc-step {{#if active}}active{{/if}} {{#if complete}}complete{{/if}}"
                data-step-index="{{@index}}"
                {{#if disabled}}disabled{{/if}}>
            <span class="mc-step-number">{{#if complete}}✓{{else}}{{number}}{{/if}}</span>
            <span>{{label}}</span>
            {{#if errors}}<span class="mc-step-error-count {{#if advisoryOnly}}advisory{{/if}}">{{errors}}</span>{{/if}}
        </button>
        {{/each}}
    </nav>

    {{#if draftRestored}}
    <div class="mc-draft-note">
        <i class="fa-solid fa-floppy-disk"></i>
        Restored your saved character draft. Progress is saved automatically.
    </div>
    {{/if}}

    {{#if oldDraftReset}}
    <div class="mc-draft-note mc-draft-reset-note">
        <i class="fa-solid fa-circle-info"></i>
        The creation workflow changed in this version, so the older draft was reset to prevent mixed base/freebie accounting.
    </div>
    {{/if}}

    {{#if phaseBase}}
    {{#if stepConcept}}
    <section class="mc-concept-ribbon" aria-label="Character creation progress">
        <strong><i class="fa-solid fa-user-pen" aria-hidden="true"></i> Concept</strong>
        <span>Define the Mage first. Dot allocation comes next.</span>
        <details class="mc-concept-rules" data-panel-key="concept-rules">
            <summary>Creation rules</summary>
            <div class="mc-concept-rule-list">
                <span>Attributes <b>7 / 5 / 3</b></span>
                <span>Abilities <b>13 / 9 / 5</b></span>
                <span>Spheres <b>{{rules.baseSphereDots}}</b></span>
                <span>Backgrounds <b>{{rules.baseBackgroundDots}}</b></span>
                <span>Arete / Willpower <b>{{rules.baseArete}} / {{rules.baseWillpower}}</b></span>
                <span>Freebies <b>After Base Review</b></span>
            </div>
        </details>
    </section>
    {{else}}
    <section class="mc-quick-rules base-phase" aria-label="Base creation rules">
        <div class="mc-quick-rule"><strong>Base Creation</strong><span>Finish these allocations first</span></div>
        <div class="mc-quick-rule"><strong>Attributes</strong><span>1 free each, then 7 / 5 / 3</span></div>
        <div class="mc-quick-rule"><strong>Abilities</strong><span>13 / 9 / 5 · max 3 now</span></div>
        <div class="mc-quick-rule"><strong>Spheres</strong><span>{{rules.baseSphereDots}} base dots</span></div>
        <div class="mc-quick-rule"><strong>Backgrounds</strong><span>{{rules.baseBackgroundDots}} base dots</span></div>
        <div class="mc-quick-rule"><strong>Arete / Willpower</strong><span>{{rules.baseArete}} / {{rules.baseWillpower}} now</span></div>
        <div class="mc-quick-costs">
            <strong>Freebie Points come later.</strong>
            Finish the normal character first; Base Review will unlock the dedicated Freebies tab.
        </div>
    </section>
    {{/if}}
    {{else}}
    <section class="mc-quick-rules freebie-phase" aria-label="Freebie point rules">
        <div class="mc-quick-rule"><strong>Freebie Phase</strong><span>Base character is locked</span></div>
        <div class="mc-quick-rule"><strong>Attribute</strong><span>{{rules.freebieCosts.attribute}} FP / dot</span></div>
        <div class="mc-quick-rule"><strong>Ability</strong><span>{{rules.freebieCosts.ability}} FP / dot</span></div>
        <div class="mc-quick-rule"><strong>Sphere</strong><span>{{rules.freebieCosts.sphere}} FP / dot</span></div>
        <div class="mc-quick-rule"><strong>Background</strong><span>{{rules.freebieCosts.background}} FP / dot</span></div>
        <div class="mc-quick-rule"><strong>Arete / Willpower</strong><span>{{rules.freebieCosts.arete}} / {{rules.freebieCosts.willpower}} FP</span></div>
        <div class="mc-quick-budget">
            <strong>{{freebieEvaluation.freebiesSpent}} / {{rules.freebies}} spent</strong>
            <span>{{freebieEvaluation.freebiesRemaining}} remaining</span>
        </div>
    </section>
    {{/if}}

    <div class="mc-layout">
        <main class="mc-main">
            {{#unless stepConcept}}
            <details class="mc-dot-guide" data-panel-key="dot-guide"><summary>What do the dots mean?</summary><label>Category<select data-guide-category>{{#each guideCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Trait<select data-guide-trait>{{#each guideTraits}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p class="mc-description">{{guideInfo}}</p></details>
            {{/unless}}

            {{#if hasCurrentIssues}}
            <section class="mc-current-issues {{#if stepConcept}}mc-concept-issue{{/if}} {{#if currentHasHard}}bad{{else}}warning{{/if}}" aria-live="polite">
                {{#if showCurrentIssues}}
                <div class="mc-current-issue-summary">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                        <strong>{{currentIssueCountLabel}}</strong>
                        <span>{{currentIssueSummary}}</span>
                    </div>
                    <button type="button" class="mc-issue-dismiss" data-dismiss-current-issues title="Hide this warning for now">×</button>
                </div>
                {{else}}
                <div class="mc-current-issue-summary muted">
                    <i class="fa-solid fa-eye-slash"></i>
                    <div><strong>Warnings hidden for this tab.</strong><span>Review still checks everything.</span></div>
                    <button type="button" class="mc-issue-show" data-show-current-issues>Show</button>
                </div>
                {{/if}}
            </section>
            {{else}}
                {{#unless stepBaseReview}}
                    {{#unless stepFinalReview}}
                        {{#unless stepFreebies}}
                    <section class="mc-current-issues clear {{#if stepConcept}}mc-concept-issue{{/if}}">
                        <div class="mc-current-issue-summary good">
                            <i class="fa-solid fa-circle-check"></i>
                            <div><strong>No current problems on this tab.</strong><span>Continue when you are ready.</span></div>
                        </div>
                    </section>
                        {{/unless}}
                    {{/unless}}
                {{/unless}}
            {{/if}}

            {{#if stepConcept}}
            <section class="mc-panel mc-concept-panel">
                <header class="mc-concept-heading">
                    <h2>Concept</h2>
                    <p>Who is your Mage, and how do they see the world?</p>
                </header>

                <div class="mc-form-grid two-col mc-concept-fields">
                    <div class="mc-concept-section-title wide">Campaign</div>
                    <label><span>Player</span><input type="text" data-path="identity.player" value="{{state.identity.player}}" placeholder="Player name"></label>
                    <label><span>Chronicle</span><input type="text" data-path="identity.chronicle" value="{{state.identity.chronicle}}" placeholder="Chronicle name"></label>

                    <div class="mc-concept-section-title wide">Character</div>
                    <label><span>Name</span><input type="text" data-path="identity.name" value="{{state.identity.name}}" placeholder="Mage's name"></label>
                    {{#each identityChoices}}
                    {{#if sectionStart}}<div class="mc-concept-section-title wide">{{sectionTitle}}</div>{{/if}}
                    <div class="mc-concept-field">
                        <label for="mc-concept-{{key}}">{{label}}</label>
                        <div class="mc-concept-combo" data-concept-combo>
                            <input type="text" id="mc-concept-{{key}}" data-concept-input data-path="{{path}}"
                                   value="{{value}}" placeholder="Choose or type…" autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false">
                            <button type="button" class="mc-concept-toggle" data-concept-toggle
                                    aria-label="Show all {{label}} options" title="Show all options">
                                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </button>
                            <div hidden data-concept-options>
                                {{#each choices}}<span data-concept-option data-value="{{this}}">{{this}}</span>{{/each}}
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    <div class="mc-concept-field">
                        <label for="mc-concept-affinitySphere">Affinity Sphere</label>
                        <div class="mc-concept-combo" data-concept-combo data-concept-strict="sphere">
                            <input type="text" id="mc-concept-affinitySphere" data-concept-input
                                   value="{{affinityDisplay}}" placeholder="Choose a Sphere" autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false">
                            <button type="button" class="mc-concept-toggle" data-concept-toggle
                                    aria-label="Show all Affinity Sphere options" title="Show all Spheres">
                                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </button>
                            <div hidden data-concept-options>
                                <span data-concept-option data-value="">Choose a Sphere</span>
                                {{#each spheres}}<span data-concept-option data-value="{{id}}">{{name}}</span>{{/each}}
                            </div>
                        </div>
                    </div>
                    <div class="mc-concept-field">
                        <label for="mc-concept-essence">Essence</label>
                        <div class="mc-concept-combo" data-concept-combo>
                            <input type="text" id="mc-concept-essence" data-concept-input
                                   data-path="{{essenceChoice.path}}" value="{{essenceChoice.value}}"
                                   placeholder="Choose or type…" autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false">
                            <button type="button" class="mc-concept-toggle" data-concept-toggle
                                    aria-label="Show all Essence options" title="Show all options">
                                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </button>
                            <div hidden data-concept-options>
                                {{#each essenceChoice.choices}}<span data-concept-option data-value="{{this}}">{{this}}</span>{{/each}}
                            </div>
                        </div>
                    </div>
                </div>

                <p class="mc-concept-hint">Choose a suggestion or enter custom text. Affinity Sphere must be chosen from the list.</p>

                <div class="mc-concept-arete-option" role="group" aria-label="Starting Arete GM option">
                    <strong>Starting Arete</strong>
                    <label class="mc-concept-arete">
                        <input type="checkbox" data-free-arete2 {{#if state.freeArete2}}checked{{/if}}>
                        <span>Start at Arete 2 <small>(GM option; no Freebie cost)</small></span>
                    </label>
                    <span class="mc-concept-arete-note">Default: Arete 1</span>
                </div>

                <details class="mc-concept-disclosure" data-panel-key="concept-story">
                    <summary>Character story &amp; magick <span class="mc-concept-muted">Optional details</span></summary>
                    <div class="mc-form-grid mc-concept-story">
                        <label><span>Appearance</span><textarea data-path="identity.appearance" rows="2" placeholder="Clothing, features, mannerisms…">{{state.identity.appearance}}</textarea></label>
                        <label><span>Biography</span><textarea data-path="identity.biography" rows="4" placeholder="History, Awakening, relationships and goals…">{{state.identity.biography}}</textarea></label>
                        <label><span>Roleplaying notes</span><textarea data-path="identity.rpTips" rows="3" placeholder="Voice, motivations, beliefs, roleplaying cues…">{{state.identity.rpTips}}</textarea></label>
                        <label><span>Paradigm</span><textarea data-path="identity.paradigm" rows="2" placeholder="What does your Mage believe makes magick possible?">{{state.identity.paradigm}}</textarea></label>
                        <label><span>Practice</span><textarea data-path="identity.practice" rows="2" placeholder="Faith healing, prayer, alchemy, technomancy…">{{state.identity.practice}}</textarea></label>
                        <label><span>Instruments</span><textarea data-path="identity.instruments" rows="2" placeholder="Scripture, focus items, gestures, rituals…">{{state.identity.instruments}}</textarea></label>
                    </div>
                </details>
            </section>
            {{/if}}

            {{#if stepAttributes}}
            <section class="mc-panel">
                <h2>Attributes</h2>
                <div class="mc-instructions">
                    <strong>Step 1: choose priorities.</strong>
                    Set Physical, Social, and Mental so one is <strong>Primary</strong>, one <strong>Secondary</strong>, and one <strong>Tertiary</strong>.
                    Attribute dots stay locked until all three are chosen. Every Attribute already has its first dot free; then place exactly <strong>7 / 5 / 3</strong> additional dots.
                    During base creation an Attribute cannot exceed 4. The fifth dot, if wanted, is bought later with Freebie Points.
                </div>

                {{#unless attributePrioritiesReady}}
                <div class="mc-priority-lock"><i class="fa-solid fa-lock"></i><strong>Choose all three Attribute priorities to unlock the dots.</strong></div>
                {{/unless}}

                <div class="mc-three-columns mc-attributes {{#unless attributePrioritiesReady}}ratings-locked{{/unless}}">
                    {{#each attrGroups}}
                    <div class="mc-rating-group">
                        <div class="mc-group-heading">
                            <h3>{{name}}</h3>
                            <select data-priority-kind="attributes" data-priority-group="{{id}}">
                                {{#each priorityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                            </select>
                        </div>

                        <div class="mc-allocation {{#if status.blocked}}blocked{{else}}{{#if status.over}}over{{else}}{{#if status.remaining}}under{{else}}complete{{/if}}{{/if}}{{/if}}">
                            {{#if status.blocked}}
                            <div class="mc-allocation-message">Choose Primary / Secondary / Tertiary first.</div>
                            {{else}}
                            <div class="mc-allocation-line"><span>Base dots placed</span><strong>{{status.used}} / {{status.pool}}</strong></div>
                            {{#if status.remaining}}<div class="mc-allocation-message">Place <strong>{{status.remaining}} more</strong> base dot(s) here.</div>{{/if}}
                            {{#if status.over}}<div class="mc-overage-message"><strong>Remove {{status.over}} dot(s).</strong> This category is over its normal allocation.</div>{{/if}}
                            {{#if status.complete}}<div class="mc-allocation-message good">Base allocation complete.</div>{{/if}}
                            {{/if}}
                        </div>

                        {{#each attributes}}
                        <div class="mc-rating-row">
                            <div class="mc-rating-label"><span class="mc-rating-name {{#if nonCore}}mc-noncore{{/if}}">{{name}}{{#if nonCore}} **{{/if}}</span>{{#if info}}<span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}{{#if nonCore}}
Non-core: explicit DM approval required.{{/if}}</span></span>{{/if}}{{#if ratingLabel}}<small class="mc-rank-label">{{ratingLabel}}</small>{{/if}}{{#if dmApproval}}<small class="mc-dm-note">Rating 4+: explicit DM approval required.</small>{{/if}}</div>
                            <div class="mc-dot-control">
                                {{#each dots}}
                                <button type="button"
                                        class="mc-dot {{#if filled}}filled{{/if}} {{#if future}}future{{/if}}"
                                        data-rating-kind="attribute"
                                        data-rating-key="{{../id}}"
                                        data-rating-value="{{value}}"
                                        {{#if disabled}}disabled{{/if}}
                                        aria-label="{{#if future}}Available during Freebies{{else}}Set {{../name}} to {{value}}{{/if}}"></button>
                                {{/each}}
                                <span class="mc-rating-value">{{value}}</span>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{/each}}
                </div>
            </section>
            {{/if}}

            {{#if stepAbilities}}
            <section class="mc-panel mc-streamlined-tab">
                <h2>Abilities</h2>
                <p class="mc-tab-summary">13 / 9 / 5 base dots · choose one Primary, one Secondary, and one Tertiary · max 3 during base creation.</p>
                <p class="mc-noncore-note">** Non-core: explicit DM approval required. Core overlaps are listed as alternate names in the information hover.</p>
                <div class="mc-instructions compact">
                    <strong>Choose the three priorities first.</strong>
                    Once Talents, Skills, and Knowledges are all assigned, the dot controls unlock. Ratings 4-5 are purchased later with Freebie Points.
                </div>

                {{#unless abilityPrioritiesReady}}
                <div class="mc-priority-lock compact"><i class="fa-solid fa-lock"></i><strong>Set Talents, Skills, and Knowledges to Primary / Secondary / Tertiary to unlock dots.</strong></div>
                {{/unless}}

                <div class="mc-three-columns mc-abilities {{#unless abilityPrioritiesReady}}ratings-locked{{/unless}}">
                    {{#each abilityGroups}}
                    <div class="mc-rating-group">
                        <div class="mc-group-heading">
                            <h3>{{name}}</h3>
                            <select data-priority-kind="abilities" data-priority-group="{{id}}">
                                {{#each priorityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                            </select>
                        </div>

                        {{#if status.blocked}}
                        <div class="mc-mini-note">Choose a priority above to unlock this section.</div>
                        {{else}}
                        <div class="mc-allocation compact {{#if status.over}}over{{else}}{{#if status.remaining}}under{{else}}complete{{/if}}{{/if}}">
                            <div class="mc-allocation-line"><span>Base dots placed</span><strong>{{status.used}} / {{status.pool}}</strong></div>
                            {{#if status.remaining}}<div class="mc-allocation-message">Place <strong>{{status.remaining}} more</strong> base dot(s) here.</div>{{/if}}
                            {{#if status.over}}<div class="mc-overage-message"><strong>Remove {{status.over}} dot(s).</strong></div>{{/if}}
                            {{#if status.complete}}<div class="mc-allocation-message good">Base allocation complete.</div>{{/if}}
                        </div>
                        {{/if}}

                        {{#each abilities}}
                        {{#if firstNonCore}}<div class="mc-extra-selected-label">GM-approved {{../name}} <small>Storyteller approval required</small></div>{{/if}}
                        <div class="mc-rating-row">
                            <div class="mc-rating-label"><span class="mc-rating-name {{#if nonCore}}mc-noncore{{/if}}">{{name}}{{#if nonCore}} **{{/if}}</span>{{#if info}}<span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}{{#if nonCore}}
Non-core: explicit DM approval required.{{/if}}</span></span>{{/if}}{{#if ratingLabel}}<small class="mc-rank-label">{{ratingLabel}}</small>{{/if}}{{#if dmApproval}}<small class="mc-dm-note">Rating 4+: explicit DM approval required.</small>{{/if}}</div>
                            <div class="mc-dot-control">
                                {{#each dots}}
                                <button type="button"
                                        class="mc-dot {{#if filled}}filled{{/if}} {{#if future}}future{{/if}}"
                                        data-rating-kind="ability"
                                        data-rating-key="{{../id}}"
                                        data-rating-value="{{value}}"
                                        {{#if disabled}}disabled{{/if}}
                                        aria-label="{{#if future}}Available during Freebies{{else}}Set {{../name}} to {{value}}{{/if}}"></button>
                                {{/each}}
                                <span class="mc-rating-value">{{value}}</span>
                            </div>
                        </div>
                        {{/each}}

                        <details class="mc-trait-picker mc-extra-picker" data-panel-key="extras-{{id}}">
                            <summary><span><i class="fa-solid fa-plus" aria-hidden="true"></i> Additional / GM-approved {{name}}</span><small>{{extraAbilities.length}} available</small></summary>
                            <div class="mc-extra-picker-note">Select an ability to add its dot track. GM approval is required; the ability costs no points until rated.</div>
                            <div class="mc-extra-options">
                            {{#each extraAbilities}}
                                <div class="mc-extra-option">
                                    <button type="button" data-add-ability="{{id}}" aria-label="Add {{name}} to this character"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{name}}</span></button>
                                    <span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}</span></span>
                                </div>
                            {{else}}
                                <p class="mc-extra-empty">All available additions are already selected.</p>
                            {{/each}}
                            </div>
                        </details>
                    </div>
                    {{/each}}
                </div>
            </section>
            {{/if}}

            {{#if stepMagic}}
            <section class="mc-panel mc-streamlined-tab">
                <h2>Magic & Backgrounds</h2>
                <p class="mc-tab-summary">Allocate {{rules.baseSphereDots}} Sphere dots and {{rules.baseBackgroundDots}} Background dots. Your Affinity Sphere still needs at least 1 dot.</p>
                <div class="mc-magic-fixed-summary" role="note" aria-label="Starting Arete and Willpower">
                    <span class="mc-magic-fixed-item"><span>Arete</span><strong>{{areteValue}}</strong></span>
                    <span class="mc-magic-fixed-item"><span>Willpower</span><strong>{{willpowerValue}}</strong></span>
                    <span class="mc-magic-fixed-help">Starting values are fixed; raise them during Freebies.</span>
                </div>
                <details class="mc-magic-rules" data-panel-key="magic-rules">
                    <summary>Planning higher starting Spheres</summary>
                    <p>You may plan a starting Sphere up to {{rules.creationCaps.arete}}. If more Arete is required, the Freebies step automatically purchases the necessary Arete before optional spending.</p>
                </details>

                <div class="mc-split-section">
                    <div class="mc-rating-group">
                        <div class="mc-group-heading"><h3>Spheres</h3><strong>{{baseEvaluation.sphereStatus.used}} / {{rules.baseSphereDots}}</strong></div>
                        <div class="mc-allocation compact {{#if baseEvaluation.sphereStatus.over}}over{{else}}{{#if baseEvaluation.sphereStatus.remaining}}under{{else}}complete{{/if}}{{/if}}">
                            {{#if baseEvaluation.sphereStatus.remaining}}<div class="mc-allocation-message">Place <strong>{{baseEvaluation.sphereStatus.remaining}} more</strong> base Sphere dot(s).</div>{{/if}}
                            {{#if baseEvaluation.sphereStatus.over}}<div class="mc-overage-message"><strong>Remove {{baseEvaluation.sphereStatus.over}} Sphere dot(s).</strong></div>{{/if}}
                            {{#if baseEvaluation.sphereStatus.complete}}<div class="mc-allocation-message good">Sphere allocation complete.</div>{{/if}}
                        </div>

                        {{#if spherePlanNeedsArete}}
                        <div class="mc-sphere-plan warning" role="note">
                            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                            <div><strong>Requires Arete {{requiredArete}}.</strong> Freebies automatically adds {{requiredAreteDots}} Arete dot(s) for {{requiredAreteFreebieCost}} FP.</div>
                        </div>
                        {{/if}}

                        <div class="mc-list-grid">
                            {{#each spheres}}
                            <div class="mc-rating-row {{#if affinitySelected}}affinity{{/if}}">
                                <div class="mc-rating-label"><span class="mc-rating-name {{#if nonCore}}mc-noncore{{/if}}">{{name}}{{#if nonCore}} **{{/if}}</span>{{#if info}}<span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}{{#if nonCore}}
Non-core: explicit DM approval required.{{/if}}</span></span>{{/if}}{{#if ratingLabel}}<small class="mc-rank-label">{{ratingLabel}}</small>{{/if}}{{#if dmApproval}}<small class="mc-dm-note">Rating 4+: explicit DM approval required.</small>{{/if}}{{#if affinitySelected}}<span class="mc-affinity-badge">Affinity</span>{{/if}}</div>
                                <div class="mc-dot-control">
                                    {{#each dots}}
                                    <button type="button"
                                            class="mc-dot {{#if filled}}filled{{/if}} {{#if future}}future{{/if}}"
                                            data-rating-kind="sphere"
                                            data-rating-key="{{../id}}"
                                            data-rating-value="{{value}}"
                                            {{#if disabled}}disabled{{/if}}
                                            aria-label="{{#if future}}Not available during starting character creation (Arete maximum {{@root.rules.creationCaps.arete}}){{else}}Set {{../name}} to {{value}}{{/if}}"></button>
                                    {{/each}}
                                    <span class="mc-rating-value">{{value}}</span>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    <div class="mc-rating-group">
                        <div class="mc-group-heading"><h3>Backgrounds</h3><strong>{{baseEvaluation.backgroundStatus.used}} / {{rules.baseBackgroundDots}}</strong></div>
                        <div class="mc-allocation compact {{#if baseEvaluation.backgroundStatus.over}}over{{else}}{{#if baseEvaluation.backgroundStatus.remaining}}under{{else}}complete{{/if}}{{/if}}">
                            {{#if baseEvaluation.backgroundStatus.remaining}}<div class="mc-allocation-message">Place <strong>{{baseEvaluation.backgroundStatus.remaining}} more</strong> base Background dot(s).</div>{{/if}}
                            {{#if baseEvaluation.backgroundStatus.over}}<div class="mc-overage-message"><strong>Remove {{baseEvaluation.backgroundStatus.over}} Background dot(s).</strong></div>{{/if}}
                            {{#if baseEvaluation.backgroundStatus.complete}}<div class="mc-allocation-message good">Background allocation complete.</div>{{/if}}
                        </div>

                        <div class="mc-list-grid">
                            {{#each backgrounds}}
                            <div class="mc-rating-row">
                                <div class="mc-rating-label"><span class="mc-rating-name {{#if nonCore}}mc-noncore{{/if}}">{{name}}{{#if nonCore}} **{{/if}}</span>{{#if info}}<span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}{{#if nonCore}}
Non-core: explicit DM approval required.{{/if}}{{#if isAvatar}} Starting Quintessence equals the Avatar rating.{{/if}}</span></span>{{/if}}{{#if ratingLabel}}<small class="mc-rank-label">{{ratingLabel}}</small>{{/if}}{{#if dmApproval}}<small class="mc-dm-note">Rating 4+: explicit DM approval required.</small>{{/if}}</div>
                                <div class="mc-dot-control">
                                    {{#each dots}}
                                    <button type="button"
                                            class="mc-dot {{#if filled}}filled{{/if}}"
                                            data-rating-kind="background"
                                            data-rating-key="{{../key}}"
                                            data-rating-value="{{value}}"
                                            {{#if disabled}}disabled{{/if}}></button>
                                    {{/each}}
                                    <span class="mc-rating-value">{{value}}</span>
                                </div>
                            </div>
