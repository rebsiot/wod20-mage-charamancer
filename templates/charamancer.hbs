                            <label for="{{listId}}"><strong>{{name}}</strong> <small>{{kind}} · {{rating}} dots</small></label>
                            <div class="mc-specialty-combo" data-specialty-combo>
                                <input id="{{listId}}" type="text" data-specialty-input data-path="{{path}}" value="{{value}}" placeholder="Choose or type a specialty" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" required>
                                <button type="button" class="mc-specialty-toggle" data-specialty-toggle aria-label="Show all {{name}} specialties" title="Show all specialty suggestions" aria-expanded="false"><i class="fa-solid fa-chevron-down"></i></button>
                                <template data-specialty-options>{{#each suggestions}}<span data-specialty-option>{{this}}</span>{{/each}}</template>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </section>
                {{/if}}

                <div class="mc-review-grid">
                    <div>
                        <h3>{{state.identity.name}}</h3>
                        <dl>
                            <dt>Player</dt><dd>{{state.identity.player}}</dd><dt>Chronicle</dt><dd>{{state.identity.chronicle}}</dd><dt>Faction</dt><dd>{{state.identity.sect}}</dd><dt>Concept</dt><dd>{{state.identity.concept}}</dd>
                            <dt>Affiliation</dt><dd>{{state.identity.affiliation}}</dd>
                            <dt>Essence</dt><dd>{{state.identity.essence}}</dd>
                            <dt>Arete</dt><dd>{{state.core.arete}}</dd>
                            <dt>Willpower</dt><dd>{{state.core.willpower}}</dd>
                            <dt>Avatar</dt><dd>{{avatarRating}}</dd>
                            <dt>Starting Quintessence</dt><dd>{{quintessence}}</dd>
                            <dt>Paradox</dt><dd>0</dd>
                        </dl>
                    </div>
                    <div>
                        <h3>Freebie Points</h3>
                        <dl>
                            <dt>Attributes</dt><dd>{{freebieEvaluation.freebieDots.attributes}} dots × {{rules.freebieCosts.attribute}} = {{freebieEvaluation.freebieBreakdown.attributes}}</dd>
                            <dt>Abilities</dt><dd>{{freebieEvaluation.freebieDots.abilities}} dots × {{rules.freebieCosts.ability}} = {{freebieEvaluation.freebieBreakdown.abilities}}</dd>
                            <dt>Spheres</dt><dd>{{freebieEvaluation.freebieDots.spheres}} dots × {{rules.freebieCosts.sphere}} = {{freebieEvaluation.freebieBreakdown.spheres}}</dd>
                            <dt>Backgrounds</dt><dd>{{freebieEvaluation.freebieDots.backgrounds}} dots × {{rules.freebieCosts.background}} = {{freebieEvaluation.freebieBreakdown.backgrounds}}</dd>
                            <dt>Arete</dt><dd>{{freebieEvaluation.freebieDots.arete}} dots × {{rules.freebieCosts.arete}} = {{freebieEvaluation.freebieBreakdown.arete}}</dd>
                            <dt>Willpower</dt><dd>{{freebieEvaluation.freebieDots.willpower}} dots × {{rules.freebieCosts.willpower}} = {{freebieEvaluation.freebieBreakdown.willpower}}</dd>
                            <dt><strong>Spent</strong></dt><dd><strong>{{freebieEvaluation.freebiesSpent}} / {{rules.freebies}}</strong></dd>
                            <dt>Remaining</dt><dd>{{freebieEvaluation.freebiesRemaining}}</dd>
                        </dl>
                    </div>
                </div>
            </section>
            {{/if}}
        </main>

        <aside class="mc-sidebar">
            {{#if phaseBase}}
            <section class="mc-sidebar-card">
                <h3>Base Creation Progress</h3>
                <div class="mc-status-line"><span>Attribute priorities</span><strong>{{#if attributePrioritiesReady}}Ready{{else}}Choose first{{/if}}</strong></div>
                <div class="mc-status-line"><span>Ability priorities</span><strong>{{#if abilityPrioritiesReady}}Ready{{else}}Choose first{{/if}}</strong></div>
                <div class="mc-status-line"><span>Spheres</span><strong>{{baseEvaluation.sphereStatus.used}} / {{rules.baseSphereDots}}</strong></div>
                <div class="mc-status-line"><span>Backgrounds</span><strong>{{baseEvaluation.backgroundStatus.used}} / {{rules.baseBackgroundDots}}</strong></div>
                <div class="mc-status-line"><span>Starting Quintessence</span><strong>{{quintessence}}</strong></div>
                <div class="mc-status-line"><span>Items remaining</span><strong>{{baseEvaluation.errors.length}}</strong></div>
            </section>

            <section class="mc-sidebar-card">
                <h3>What happens next?</h3>
                <p>Finish the normal character first. Base Review then locks these ratings and opens a separate {{rules.freebies}}-point Freebie phase.</p>
                <p><strong>No Freebie Points are being spent on the current pages.</strong></p>
            </section>

            {{else}}
            <section class="mc-sidebar-card">
                <h3>Freebie Budget</h3>
                <div class="mc-budget-line"><span>Attributes</span><strong>{{freebieEvaluation.freebieBreakdown.attributes}} FP</strong></div>
                <div class="mc-budget-line"><span>Abilities</span><strong>{{freebieEvaluation.freebieBreakdown.abilities}} FP</strong></div>
                <div class="mc-budget-line"><span>Spheres</span><strong>{{freebieEvaluation.freebieBreakdown.spheres}} FP</strong></div>
                <div class="mc-budget-line"><span>Merits</span><strong>{{meritTotals.merits}} FP</strong></div><div class="mc-budget-line"><span>Flaw bonus credited</span><strong>+{{meritTotals.bonus}} FP</strong></div><div class="mc-budget-line"><span>Backgrounds</span><strong>{{freebieEvaluation.freebieBreakdown.backgrounds}} FP</strong></div>
                <div class="mc-budget-line"><span>Arete</span><strong>{{freebieEvaluation.freebieBreakdown.arete}} FP</strong></div>
                <div class="mc-budget-line"><span>Willpower</span><strong>{{freebieEvaluation.freebieBreakdown.willpower}} FP</strong></div>
                <hr>
                <div class="mc-budget-total"><span>Spent</span><strong>{{freebieEvaluation.freebiesSpent}} / {{rules.freebies}}</strong></div>
                <div class="mc-budget-remaining"><span>Remaining</span><strong>{{freebieEvaluation.freebiesRemaining}}</strong></div>
            </section>

            <section class="mc-sidebar-card mc-legend">
                <h3>Dot colors</h3>
                <div><span class="mc-legend-dot filled"></span><span>Locked base-character dot</span></div>
                <div><span class="mc-legend-dot freebie"></span><span>Purchased with Freebie Points</span></div>
                <div><span class="mc-legend-dot unavailable"></span><span>Cannot afford this target</span></div>
                <p>Green dots are purchased Freebie dots. Red targets are disabled because the purchase would exceed the remaining budget.</p>
            </section>

            <section class="mc-sidebar-card">
                <h3>Freebie Costs</h3>
                <div class="mc-status-line"><span>Attribute</span><strong>{{rules.freebieCosts.attribute}}</strong></div>
                <div class="mc-status-line"><span>Ability</span><strong>{{rules.freebieCosts.ability}}</strong></div>
                <div class="mc-status-line"><span>Sphere</span><strong>{{rules.freebieCosts.sphere}}</strong></div>
                <div class="mc-status-line"><span>Background</span><strong>{{rules.freebieCosts.background}}</strong></div>
                <div class="mc-status-line"><span>Arete</span><strong>{{rules.freebieCosts.arete}}</strong></div>
                <div class="mc-status-line"><span>Willpower</span><strong>{{rules.freebieCosts.willpower}}</strong></div>
            </section>
            {{/if}}
        </aside>
    </div>

    <footer class="mc-footer">
        <button type="button" class="mc-reset" data-reset-draft title="Clear all saved charamancer progress">
            <i class="fa-solid fa-rotate-left"></i> Start Over
        </button>
        <button type="button" data-nav="back" {{#unless canBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> {{backLabel}}</button>
        <div class="mc-footer-spacer"></div>
        <span class="mc-autosave"><i class="fa-solid fa-floppy-disk"></i> Autosaved</span>
        {{#if canNext}}
        <button type="button" data-nav="next" {{#if nextDisabled}}disabled{{/if}}>{{nextLabel}} <i class="fa-solid fa-arrow-right"></i></button>
        {{else}}
        <button type="button" class="mc-create" data-create-mage {{#unless canCreate}}disabled{{/unless}}>
            {{#if creating}}Creating…{{else}}<i class="fa-solid fa-wand-magic-sparkles"></i> Create Mage{{/if}}
        </button>
        {{/if}}
    </footer>
</div>
