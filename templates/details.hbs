<div class="mc-details-body">
{{#if selectMode}}
<h2>Mage Details</h2><label>Choose a PC Mage <select data-details-actor>{{#each actors}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><button type="button" data-details-load>Open Mage Details</button>
{{else}}
<h2>{{actorName}}</h2><p>Player: {{player}} · Chronicle: {{chronicle}}</p>
<section class="mc-details-card"><h3>Character</h3><p>Affiliation: {{identity.affiliation}} · Faction: {{identity.sect}}</p><h4>Appearance</h4><p class="mc-description">{{narrative.appearanceDescription}}</p><h4>Biography</h4><p class="mc-description">{{narrative.biography}}</p><h4>RP tips / direction</h4><p class="mc-description">{{narrative.rpTips}}</p></section>
<section class="mc-details-card"><h3>Experience</h3><div class="mc-xp-summary"><div><strong>{{xp.unspent}}</strong><span>Unspent</span></div><div><strong>{{xp.spent}}</strong><span>Spent</span></div><div><strong>{{xp.earned}}</strong><span>Total Earned</span></div></div><p>Unspent + Spent = Total Earned</p>{{#if invalidLedger}}<p class="mc-validation error">Spent XP exceeds Total Earned. Review the actor's Experience records.</p>{{/if}}{{#if editable}}<button type="button" data-details-spend>Spend XP</button><button type="button" data-details-add>Add XP</button>{{/if}}<details class="mc-xp-history"><summary>XP history ({{xpHistory.length}} transactions)</summary>
<div class="mc-xp-history-list">{{#each xpHistory}}
<div class="mc-xp-history-row"><div><strong>{{date}} · {{kind}}</strong><span>{{description}}</span>{{#each details}}<small>{{this}}</small>{{/each}}</div><strong>{{sign}}{{amount}} XP</strong></div>
{{else}}<p>No XP transactions recorded.</p>{{/each}}</div></details></section>
{{#if hasSpecialties}}<section class="mc-details-card"><h3>Specialties</h3><p>Attributes and Abilities rated 4+ require a specialty before spending XP. Correcting a specialty costs no XP.</p>{{#if missing}}<p class="mc-validation warning">Missing: {{missing}}</p>{{/if}}<div class="mc-specialty-grid">{{#each specialties}}<label>{{name}}<input type="text" data-specialty-kind="{{kind}}" data-key="{{key}}" data-item-id="{{itemId}}" data-name="{{name}}" value="{{value}}" list="{{listId}}" placeholder="Choose or type a specialty" {{#unless ../editable}}disabled{{/unless}}><datalist id="{{listId}}">{{#each suggestions}}<option value="{{this}}"></option>{{/each}}</datalist></label>{{/each}}</div>{{#if editable}}<button type="button" data-save-specialties>Save Specialties</button>{{/if}}</section>{{/if}}
<section class="mc-details-card"><h3>Traits</h3>{{#if hasNonCore}}<p>** Non-core: explicit DM approval required.</p>{{/if}}<div class="mc-details-traits">{{#each traits}}<details class="{{#if nonCore}}mc-noncore{{/if}}"><summary>{{#if nonCore}}** {{/if}}{{name}} · {{value}}{{#if speciality}} ({{speciality}}){{/if}} <span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}</span></span></summary><p class="mc-description">{{info}}</p></details>{{/each}}</div></section>
<section class="mc-details-card"><h3>Backgrounds</h3>{{#each backgrounds}}<details><summary>{{name}} · {{value}} <span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}</span></span></summary><p class="mc-description">{{info}}</p></details>{{else}}<p>No Backgrounds recorded.</p>{{/each}}</section>
<section class="mc-details-card"><h3>Merits & Flaws</h3><p>Creation costs/bonuses are shown for reference; effects are not automatically applied to rolls.</p>{{#each meritsFlaws}}<div class="mc-selected-mf"><strong>{{name}}</strong> <span>{{kindLabel}}: {{points}} FP</span><span class="mc-info" tabindex="0" aria-label="About {{name}}">i<span class="mc-tip">{{info}}</span></span><p>{{description}}</p>{{#if reference}}<small>{{reference}}</small>{{/if}}</div>{{else}}<p>No Merits or Flaws recorded.</p>{{/each}}</section>
<p>Use Create New Mage for Foundry creation, or the web charamancer for creation-budget adjustments and PDF work. This panel does not change ratings or resource trackers.</p>
{{/if}}
</div>
